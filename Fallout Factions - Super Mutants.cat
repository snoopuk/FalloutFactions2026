<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<catalogue id="23773762-8eed-5441-8b00-61a0bdb57fbc" name="Super Mutants" revision="1" battleScribeVersion="2.03" authorName="Personal use" gameSystemId="e8ea97a4-676b-55f2-a1df-54b8b97e97aa" gameSystemRevision="1" library="false" xmlns="http://www.battlescribe.net/schema/catalogueSchema">
  <readme>Source: Fallout: Factions core / Battle for Boston faction guide assembly guide supplied by the user. Ratings shown = model + weapon set.</readme>
  <selectionEntries>
    <selectionEntry id="2b57f2f2-423e-501f-b274-997a8c60b4dc" name="Crew Rules and Ploys" hidden="false" collective="false" import="true" type="upgrade">
      <constraints><constraint type="max" value="1" field="selections" scope="force" shared="true" id="38a2daba-4224-5ac4-8d7e-41e85ca9bba6"/></constraints>
      <rules>
        <rule id="d2839218-3c97-578d-be5b-9bc79ba79359" name="Crew Limits" hidden="false"><description>Upgrade Limit per model: T1 4 / T2 6 / T3 8; Champion Limit: T1 2 / T2 3 / T3 4; Total Control Limit: T1 2 / T2 4 / T3 6</description></rule>
        <rule id="46860ad9-72ca-59ff-9931-54854e7a3dd8" name="Captive Story Action" hidden="false"><description>Devour Captive (see the Fallout: Factions Rulebook). Do not use if fielding this crew in a Starter Set Campaign.</description></rule>
        <rule id="17c03a90-b0aa-5aa6-b3cc-dee2946452d6" name="Ploy: Surging Advance" hidden="false"><description>Start of any Round except the first: each Unengaged model may move up to 4", but cannot move into the Proximity of an Enemy model.</description></rule>
        <rule id="484340be-fd5a-5ad4-85ae-ba9b32e3001e" name="Ploy: The Next Stage" hidden="false"><description>Start of your Turn: Recover 1 Harm on each of your models; until the start of the next Round each gets +1 Endurance.</description></rule>
        <rule id="5d05edf1-6520-5df8-b544-4d88d107523e" name="Hound restriction" hidden="false"><description>You cannot recruit a Hound if half or more of your Grunts are already Hounds.</description></rule>
      </rules>
      <costs><cost name="Rating" typeId="682660dc-9396-5ac8-a4c4-fd893fab78f0" value="0.0"/></costs>
    </selectionEntry>
