<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<catalogue id="0745f6bb-a8e9-524a-8c87-8492be280f8b" name="Brotherhood of Steel" revision="1" battleScribeVersion="2.03" authorName="Personal use" gameSystemId="e8ea97a4-676b-55f2-a1df-54b8b97e97aa" gameSystemRevision="1" library="false" xmlns="http://www.battlescribe.net/schema/catalogueSchema">
  <readme>Source: Fallout: Factions core / Battle for Boston faction guide assembly guide supplied by the user. Ratings shown = model + weapon set.</readme>
  <selectionEntries>
    <selectionEntry id="09b1b46a-e6a6-53ae-91c2-43fb98d84cbd" name="Crew Rules and Ploys" hidden="false" collective="false" import="true" type="upgrade">
      <constraints><constraint type="max" value="1" field="selections" scope="force" shared="true" id="689b817d-1517-54ca-95b1-14a031dc733c"/></constraints>
      <rules>
        <rule id="3d5aa2b1-3140-5a92-b00d-05d6fb133700" name="Crew Limits" hidden="false"><description>Upgrade Limit per model: T1 4 / T2 6 / T3 8; Champion Limit: T1 3 / T2 4 / T3 5; Facility Limit: T1 2 / T2 4 / T3 6</description></rule>
        <rule id="cd97670e-ab6b-57db-bc40-002f5389de62" name="Captive Story Action" hidden="false"><description>Judge Captives (see the Fallout: Factions Rulebook). Do not use if fielding this crew in a Starter Set Campaign.</description></rule>
        <rule id="c6879cec-99be-51d2-8175-3d82912f2252" name="Ploy: The Chain That Binds" hidden="false"><description>Start of game, before Turn 1: each Grunt in the Control Area of a Friendly Champion may take a single action, taking Fatigue as normal.</description></rule>
        <rule id="9fcdd0bc-9cd6-57cd-81e6-fa413ab71aa6" name="Ploy: Vertibird Drop" hidden="false"><description>Before Deployment: choose one model. It isn't deployed normally; when you become Active player on Turn 2, place it in Base contact with a Battlefield edge of your choice.</description></rule>
      </rules>
      <costs><cost name="Rating" typeId="682660dc-9396-5ac8-a4c4-fd893fab78f0" value="0.0"/></costs>
    </selectionEntry>
