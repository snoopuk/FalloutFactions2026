<catalogue id="9445bff0-9fbc-5482-87e7-9d5f1425e138" name="Institute" revision="1" battleScribeVersion="2.03" authorName="Personal use" gameSystemId="e8ea97a4-676b-55f2-a1df-54b8b97e97aa" gameSystemRevision="1" library="false" xmlns="http://www.battlescribe.net/schema/catalogueSchema">
  <readme>Source: Fallout: Factions core / Battle for Boston faction guide assembly guide supplied by the user. Ratings shown = model + weapon set.</readme>
  <selectionEntries>
    <selectionEntry id="dc09895f-ef50-546b-a1ba-462931e8e8ae" name="Crew Rules and Ploys" hidden="false" collective="false" import="true" type="upgrade">
      <constraints><constraint type="max" value="1" field="selections" scope="force" shared="true" id="0146b7f9-0ab1-5008-a055-f1effad6e585"/></constraints>
      <rules>
        <rule id="5a4b54a2-7edf-519f-a1f0-96ba60f8d26a" name="Crew Limits" hidden="false"><description>Upgrade Limit per model: T1 4 / T2 6 / T3 8; Champion Limit: T1 5 / T2 6 / T3 7; Total Control Limit: T1 5 / T2 10 / T3 15</description></rule>
        <rule id="ed54c04c-455f-5818-93e6-71011adf3649" name="Ploy: Molecular Relay" hidden="false"><description>Before either crew Deploys: choose up to two Gen 1/Gen 2 Synths; they aren't Deployed normally. At the start of Round 1 place them anywhere not within an Enemy Control Area.</description></rule>
        <rule id="adcee98f-220d-5bb5-a0a0-0da705fa14ac" name="Ploy: Bogeyman of the Wasteland" hidden="false"><description>Start of game, before Turn 1: every Enemy model makes a Confusion Test (2I).</description></rule>
        <rule id="02cf7678-e599-5320-a3a1-ead1909aeeba" name="Gen 1 Synth restriction" hidden="false"><description>No more than half of the Grunts in a crew can be Gen 1 Synths.</description></rule>
      </rules>
      <costs><cost name="Rating" typeId="682660dc-9396-5ac8-a4c4-fd893fab78f0" value="0.0"/></costs>
    </selectionEntry>
