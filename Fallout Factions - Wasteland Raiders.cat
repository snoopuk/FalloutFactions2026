<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<catalogue id="8f4c990a-6225-570a-8b49-73fef36e61ce" name="Wasteland Raiders" revision="1" battleScribeVersion="2.03" authorName="Personal use" gameSystemId="e8ea97a4-676b-55f2-a1df-54b8b97e97aa" gameSystemRevision="1" library="false" xmlns="http://www.battlescribe.net/schema/catalogueSchema">
  <readme>Source: Fallout: Factions core / Battle for Boston faction guide assembly guide supplied by the user. Ratings shown = model + weapon set.</readme>
  <selectionEntries>
    <selectionEntry id="287f894e-93b7-55f9-9bb3-dd45d0bdcb8b" name="Crew Rules and Ploys" hidden="false" collective="false" import="true" type="upgrade">
      <constraints><constraint type="max" value="1" field="selections" scope="force" shared="true" id="85f0f1bc-01ef-5d70-b0a2-a774939c4de4"/></constraints>
      <rules>
        <rule id="2cce7d02-20c5-5852-938a-211787893eaa" name="Crew Limits" hidden="false"><description>Upgrade Limit per model: T1 3 / T2 5 / T3 7; Champion Limit: T1 3 / T2 5 / T3 5; Facility Limit: T1 2 / T2 4 / T3 6</description></rule>
        <rule id="478d2747-57f5-5e73-8ce3-26727826cd1c" name="Captive Story Action" hidden="false"><description>Sell Captive (see the Fallout: Factions Rulebook). Do not use if fielding this crew in a Starter Set Campaign.</description></rule>
        <rule id="2c4ede60-053e-5e5c-a369-1293b2e71303" name="Ploy: In Moderation" hidden="false"><description>When a Friendly model chooses Find a Chem during a Rummage Action: also add a single dose of any Rare Chem to your Crew Roster.</description></rule>
        <rule id="8dd0cf95-aab9-54fe-a8b5-82e0c9d1107e" name="Ploy: Oh Yeah!" hidden="false"><description>Start of any of your Turns: remove a Common or Rare Chem dose from your Roster. Choose a Friendly Exhausted Grunt, Recover all its Fatigue; until end of Round its Attack Actions add 3 Bonus Dice. When it next becomes Exhausted it can't Recover Fatigue; at end of Round it is Incapacitated.</description></rule>
        <rule id="5ebeda8c-ff70-52ba-aaff-3b723befecb3" name="Scum restriction" hidden="false"><description>You cannot recruit a Scum if half or more of your Grunts are already Scum.</description></rule>
      </rules>
      <costs><cost name="Rating" typeId="682660dc-9396-5ac8-a4c4-fd893fab78f0" value="0.0"/></costs>
    </selectionEntry>
