<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<catalogue id="2556c37b-4d21-5420-84a2-e5f6cbfac7d7" name="Minutemen" revision="1" battleScribeVersion="2.03" authorName="Personal use" gameSystemId="e8ea97a4-676b-55f2-a1df-54b8b97e97aa" gameSystemRevision="1" library="false" xmlns="http://www.battlescribe.net/schema/catalogueSchema">
  <readme>Source: Fallout: Factions core / Battle for Boston faction guide assembly guide supplied by the user. Ratings shown = model + weapon set.</readme>
  <selectionEntries>
    <selectionEntry id="a4edba47-7d32-5d8c-a3e7-85f4a642e909" name="Crew Rules and Ploys" hidden="false" collective="false" import="true" type="upgrade">
      <constraints><constraint type="max" value="1" field="selections" scope="force" shared="true" id="d4db3fd2-2383-5d2b-98d4-4765ca6d8ff1"/></constraints>
      <rules>
        <rule id="f24b310d-2e1a-54a1-bc70-0c15a3a20973" name="Crew Limits" hidden="false"><description>Upgrade Limit per model: T1 4 / T2 6 / T3 8; Champion Limit: T1 3 / T2 4 / T3 5; Total Control Limit: T1 5 / T2 10 / T3 15</description></rule>
        <rule id="01fc4c1a-97ba-5a08-8306-1c212eeba417" name="Ploy: Mortar Bombardment" hidden="false"><description>Start of your Turn: choose a Target point. All models (either crew) within 3" suffer 1 Harm; Excess Harm causes an Injury.</description></rule>
        <rule id="63c2e919-1481-5017-b1fa-ae2b0bde6ec7" name="Ploy: Rapid Response" hidden="false"><description>Start of game, before Turn 1: in the first Round, your models move 3" rather than 2" when moving as part of Covering Fire.</description></rule>
        <rule id="9e3338bf-bebd-5828-9850-e4992097e8c9" name="Militia restriction" hidden="false"><description>No more than half of the Grunts in a Minutemen crew can be Militia.</description></rule>
      </rules>
      <costs><cost name="Rating" typeId="682660dc-9396-5ac8-a4c4-fd893fab78f0" value="0.0"/></costs>
    </selectionEntry>
