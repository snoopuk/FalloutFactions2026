<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<catalogue id="7c84c574-d380-5fdf-a8d3-b0626a3786bf" name="Wasteland Survivors" revision="1" battleScribeVersion="2.03" authorName="Personal use" gameSystemId="e8ea97a4-676b-55f2-a1df-54b8b97e97aa" gameSystemRevision="1" library="false" xmlns="http://www.battlescribe.net/schema/catalogueSchema">
  <readme>Source: Fallout: Factions core / Battle for Boston faction guide assembly guide supplied by the user. Ratings shown = model + weapon set.</readme>
  <selectionEntries>
    <selectionEntry id="fe403626-24c8-5238-9739-1c5c00adc6fd" name="Crew Rules and Ploys" hidden="false" collective="false" import="true" type="upgrade">
      <constraints><constraint type="max" value="1" field="selections" scope="force" shared="true" id="b62d3958-267f-57bb-9e38-cb7f00dc7fd1"/></constraints>
      <rules>
        <rule id="e366cbf6-07a0-58aa-98a2-c0831beae016" name="Crew Limits" hidden="false"><description>Upgrade Limit per model: T1 3 / T2 5 / T3 7; Champion Limit: T1 3 / T2 4 / T3 5; Facility Limit: T1 3 / T2 5 / T3 6</description></rule>
        <rule id="bce5a0f1-d009-5a93-944d-f62645fa9f41" name="Captive Story Action" hidden="false"><description>Redeem Captive (see the Fallout: Factions Rulebook). Do not use if fielding this crew in a Starter Set Campaign.</description></rule>
        <rule id="83486324-3df0-5566-bbac-237a685e2369" name="Ploy: No Place Like Home" hidden="false"><description>When a Friendly model is Incapacitated: add 1 Bonus Dice to all Confusion Tests made as a result.</description></rule>
        <rule id="bce6f26d-07e8-597a-ae88-349e43fdfc87" name="Ploy: Some Rain Must Fall" hidden="false"><description>When a Friendly model is Incapacitated by an Enemy model, after Confusion Tests: each Friendly model may make an Open Fire or Brawl Action (no Fatigue) against that Enemy model.</description></rule>
        <rule id="99bd4ec4-a4d0-5e20-846d-2805a5797499" name="Good Boy restriction" hidden="false"><description>You cannot recruit a Good Boy if half or more of your Grunts are already Good Boys.</description></rule>
        <rule id="444e3416-cec6-5a45-a1b9-1546b51329e7" name="Settler restriction" hidden="false"><description>You cannot recruit a Settler if half or more of your Grunts are already Settlers.</description></rule>
      </rules>
      <costs><cost name="Rating" typeId="682660dc-9396-5ac8-a4c4-fd893fab78f0" value="0.0"/></costs>
    </selectionEntry>
